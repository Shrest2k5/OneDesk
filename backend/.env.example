# Application
PROJECT_NAME="OneDesk"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Data Encryption (Fernet 32-byte url-safe base64 key for encrypting OAuth tokens at rest)
# Can be generated using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="replace-with-valid-fernet-key-32-urlsafe-base64-bytes"

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="onedesk_db"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/onedesk_db"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:password@localhost:5432/onedesk_db"

# Redis & Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Zoho OAuth 2.0 Credentials
ZOHO_CLIENT_ID="your_zoho_client_id"
ZOHO_CLIENT_SECRET="your_zoho_client_secret"
ZOHO_REDIRECT_URI="http://localhost:8000/api/v1/integrations/zoho/callback"
ZOHO_SCOPES="ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.org.READ"
ZOHO_DEFAULT_ACCOUNTS_URL="https://accounts.zoho.com"

# Zoho Books OAuth 2.0 Credentials (read-only scopes only)
ZOHO_BOOKS_CLIENT_ID="your_zoho_books_client_id"
ZOHO_BOOKS_CLIENT_SECRET="your_zoho_books_client_secret"
ZOHO_BOOKS_REDIRECT_URI="http://localhost:8000/api/v1/integrations/zoho/books/callback"
ZOHO_BOOKS_SCOPES="ZohoBooks.settings.READ,ZohoBooks.contacts.READ,ZohoBooks.invoices.READ,ZohoBooks.bills.READ,ZohoBooks.expenses.READ,ZohoBooks.customerpayments.READ,ZohoBooks.vendorpayments.READ,ZohoBooks.estimates.READ,ZohoBooks.creditnotes.READ"

# Microsoft Dynamics 365 Business Central OAuth 2.0 Credentials
# The delegated Business Central permission is Financials.ReadWrite.All.
BUSINESS_CENTRAL_TENANT_ID="organizations"
BUSINESS_CENTRAL_AUTHORITY_URL="https://login.microsoftonline.com"
BUSINESS_CENTRAL_CLIENT_ID="your_business_central_client_id"
BUSINESS_CENTRAL_CLIENT_SECRET="your_business_central_client_secret"
BUSINESS_CENTRAL_REDIRECT_URI="http://localhost:8000/api/v1/integrations/business-central/callback"
BUSINESS_CENTRAL_SCOPES="openid profile email offline_access https://api.businesscentral.dynamics.com/Financials.ReadWrite.All"
BUSINESS_CENTRAL_API_BASE_URL="https://api.businesscentral.dynamics.com"

FRONTEND_BASE_URL="http://localhost:3000"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

